[Unit]
Description=NiloCardmed container (@COMPOSE_PROJECT_NAME@)
Documentation=file://@INSTALL_DIR@/README.md
Requires=@SYSTEMD_REQUIRES@
After=@SYSTEMD_AFTER@
Wants=@SYSTEMD_WANTS@

[Service]
Type=oneshot
RemainAfterExit=yes
User=@NILOCARDMED_RUN_USER@
Group=@NILOCARDMED_RUN_GROUP@
SupplementaryGroups=docker video dialout plugdev
WorkingDirectory=@INSTALL_DIR@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=COMPOSE_PROJECT_NAME=@COMPOSE_PROJECT_NAME@
Environment=COMPOSE_FILE=@COMPOSE_FILE@
EnvironmentFile=-@INSTALL_DIR@/deploy.env
EnvironmentFile=-@INSTALL_DIR@/.env
ExecStartPre=+env INSTALL_DIR=@INSTALL_DIR@ ENV_FILE=@INSTALL_DIR@/.env @INSTALL_DIR@/scripts/ensure-bluetooth-powered.sh
ExecStart=@DOCKER_COMPOSE_CMD@ up -d --remove-orphans
ExecStop=@DOCKER_COMPOSE_CMD@ down
ExecReload=@DOCKER_COMPOSE_CMD@ up -d --remove-orphans
TimeoutStartSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=@SYSTEMD_WANTED_BY@
