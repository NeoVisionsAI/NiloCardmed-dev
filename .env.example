# Directorio de datos persistentes (config, logs futuros)
# En Docker usar /data; en desarrollo local, ./data
NILOCARDMED_DATA_DIR=./data

# Directorio de logs en fichero (opcional; stdout siempre activo)
# NILOCARDMED_LOG_DIR=/var/log/nilocardmed

# Nivel de log: DEBUG, INFO, WARNING, ERROR
NILOCARDMED_LOG_LEVEL=INFO

# Logs en JSON (true/false)
NILOCARDMED_LOG_STRUCTURED=true

# Nombre del fichero de configuración dentro de DATA_DIR
NILOCARDMED_CONFIG_FILENAME=config.json

# --- API SER (contrato configurable; ajustar cuando SER lo defina) ---
NILOCARDMED_SER__ENABLED=true
NILOCARDMED_SER__URL=http://localhost:8080/api/samples
NILOCARDMED_SER__METHOD=POST
# multipart | json_base64 | json_base64_data_uri | raw_binary | octet_stream
NILOCARDMED_SER__PAYLOAD_MODE=multipart
NILOCARDMED_SER__IMAGE_FIELD_NAME=image
NILOCARDMED_SER__JSON_IMAGE_FIELD=image_base64
# NILOCARDMED_SER__FILENAME=sample.jpg
# NILOCARDMED_SER__EXTRA_FIELDS={"site":"lab1"}
# NILOCARDMED_SER__HEADERS={"X-Client":"nilocardmed"}

# Autenticación: none | bearer | header | query | basic
NILOCARDMED_SER__AUTH_TYPE=none
# NILOCARDMED_SER__API_KEY=secret-token
# NILOCARDMED_SER__AUTH_HEADER_NAME=Authorization
# NILOCARDMED_SER__AUTH_HEADER_PREFIX=Bearer
# NILOCARDMED_SER__AUTH_QUERY_PARAM=api_key
# NILOCARDMED_SER__BASIC_USERNAME=user
# NILOCARDMED_SER__BASIC_PASSWORD=pass

# install.sh asigna un uuid único por dispositivo (persistente en HOST_DATA_DIR/device-identity.env)
# NILOCARDMED_SER__DEVICE_ID=a1b2c3d4
NILOCARDMED_SER__DEVICE_ID_FIELD=device_id
NILOCARDMED_SER__CAPTURED_AT_FIELD=captured_at
NILOCARDMED_SER__INCLUDE_CAPTURED_AT=true

NILOCARDMED_SER__TIMEOUT_SECONDS=30
NILOCARDMED_SER__VERIFY_SSL=true
NILOCARDMED_SER__SUCCESS_STATUS_CODES=200,201,202,204

NILOCARDMED_SER__MAX_RETRIES=3
NILOCARDMED_SER__RETRY_BACKOFF_SECONDS=1
NILOCARDMED_SER__RETRY_BACKOFF_MULTIPLIER=2
NILOCARDMED_SER__RETRY_MAX_BACKOFF_SECONDS=30
NILOCARDMED_SER__RETRY_ON_STATUS_CODES=408,429,500,502,503,504

# --- WiFi (Fase 5) ---
NILOCARDMED_WIFI__ENABLED=true
# auto | host_script | nmcli | mock
NILOCARDMED_WIFI__BACKEND=auto
# NILOCARDMED_WIFI__SSID=mi-red
# NILOCARDMED_WIFI__PASSWORD=mi-clave
NILOCARDMED_WIFI__INTERFACE=wlan0
NILOCARDMED_WIFI__HOST_SCRIPT_PATH=/host/scripts/wifi-host.sh
NILOCARDMED_WIFI__NMCLI_BINARY=nmcli
NILOCARDMED_WIFI__SCAN_TIMEOUT_SECONDS=15
NILOCARDMED_WIFI__CONNECT_TIMEOUT_SECONDS=30
NILOCARDMED_WIFI__VERIFY_CONNECTIVITY=true
NILOCARDMED_WIFI__CONNECTIVITY_CHECK_URL=http://connectivitycheck.gstatic.com/generate_204
NILOCARDMED_WIFI__CONNECTIVITY_TIMEOUT_SECONDS=10
NILOCARDMED_WIFI__PERSIST_TO_CONFIG=true
NILOCARDMED_WIFI__AUTO_CONNECT_ON_STARTUP=false

# --- Muestreo periódico (Fase 4) ---
NILOCARDMED_SAMPLING__ENABLED=true
NILOCARDMED_SAMPLING__INTERVAL_SECONDS=60
# Ventana de monitorización (epoch Unix; -1 = sin límite / sin parar)
NILOCARDMED_SAMPLING__MONITOR_START=-1
NILOCARDMED_SAMPLING__MONITOR_END=-1
# stop | idle (al superar monitor_end)
NILOCARDMED_SAMPLING__AFTER_WINDOW_BEHAVIOR=stop
NILOCARDMED_SAMPLING__UPLOAD_ENABLED=true
NILOCARDMED_SAMPLING__DELETE_CAPTURE_AFTER_UPLOAD=true
NILOCARDMED_SAMPLING__KEEP_CAPTURE_ON_UPLOAD_FAILURE=true
NILOCARDMED_SAMPLING__INITIAL_DELAY_SECONDS=0
NILOCARDMED_SAMPLING__TICK_SLEEP_SECONDS=1
NILOCARDMED_SAMPLING__CONFIG_RELOAD_SECONDS=30
# 0 = sin límite
NILOCARDMED_SAMPLING__MAX_CONSECUTIVE_FAILURES=0
NILOCARDMED_SAMPLING__FAILURE_BACKOFF_SECONDS=0

# --- Bluetooth (Fase 6) ---
NILOCARDMED_BLUETOOTH__ENABLED=true
# install.sh asigna NiloCardmed-<uuid> (uuid persistente en HOST_DATA_DIR/device-identity.env)
NILOCARDMED_BLUETOOTH__DEVICE_NAME=NiloCardmed
# install.sh pide contraseña por consola (Enter = generar automática)
NILOCARDMED_BLUETOOTH__PASSWORD=changeme
# auto | bluez | mock
NILOCARDMED_BLUETOOTH__BACKEND=auto
NILOCARDMED_BLUETOOTH__ADAPTER=hci0
# NILOCARDMED_BLUETOOTH__ADAPTER_ADDRESS=AA:BB:CC:DD:EE:FF
NILOCARDMED_BLUETOOTH__APPEARANCE=833
NILOCARDMED_BLUETOOTH__SERVICE_UUID=6e400010-b5a3-f393-e0a9-e50e24dcca9e
NILOCARDMED_BLUETOOTH__RX_CHARACTERISTIC_UUID=6e400011-b5a3-f393-e0a9-e50e24dcca9e
NILOCARDMED_BLUETOOTH__TX_CHARACTERISTIC_UUID=6e400012-b5a3-f393-e0a9-e50e24dcca9e
NILOCARDMED_BLUETOOTH__MAX_MESSAGE_BYTES=512
NILOCARDMED_BLUETOOTH__TOKEN_TTL_SECONDS=3600
NILOCARDMED_BLUETOOTH__PRIVILEGED_TTL_SECONDS=3600
NILOCARDMED_BLUETOOTH__REQUIRE_AUTH=true
NILOCARDMED_BLUETOOTH__ALLOWED_COMMANDS_WITHOUT_AUTH=auth
# Modo por defecto de camera_capture_test: base64 | path | chunked
NILOCARDMED_BLUETOOTH__CAPTURE_TEST_MODE=chunked
NILOCARDMED_BLUETOOTH__CAPTURE_CHUNK_SIZE=200
NILOCARDMED_BLUETOOTH__MAX_RESPONSE_BYTES=4096
NILOCARDMED_BLUETOOTH__MAX_IMAGE_RESPONSE_BYTES=32768
NILOCARDMED_BLUETOOTH__MAX_CHUNK_RESPONSE_BYTES=4096
# Framing BLE para Web Bluetooth / Android (Fase 7.5)
NILOCARDMED_BLUETOOTH__BLE_FRAMING_ENABLED=true
NILOCARDMED_BLUETOOTH__BLE_MAX_NOTIFICATION_BYTES=512
NILOCARDMED_BLUETOOTH__BLE_FRAME_PAYLOAD_BYTES=200
NILOCARDMED_BLUETOOTH__BLE_INTER_FRAME_DELAY_MS=15
# NILOCARDMED_BLUETOOTH__DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket

# --- CardMed (Fase 8) ---
NILOCARDMED_CARDMED__ENABLED=true
# NILOCARDMED_CARDMED__SITE_ID=SITE-001
# NILOCARDMED_CARDMED__DEVICE_LABEL=Sala-3
# NILOCARDMED_CARDMED__LOCATION=Planta-1
# NILOCARDMED_CARDMED__OPERATOR_ID=
NILOCARDMED_CARDMED__SYNC_DEVICE_ID_TO_SER=true
# NILOCARDMED_CARDMED__METADATA={"ward":"cardiology"}
# NILOCARDMED_CARDMED__EXTRA={}
NILOCARDMED_CARDMED__TEST_UPLOAD_ENABLED=true
NILOCARDMED_CARDMED__TEST_REQUIRE_WIFI=true
NILOCARDMED_CARDMED__TEST_REQUIRE_CONNECTIVITY=true
NILOCARDMED_CARDMED__TEST_MIN_IMAGE_BYTES=1024
NILOCARDMED_CARDMED__TEST_MIN_WIDTH=320
NILOCARDMED_CARDMED__TEST_MIN_HEIGHT=240
NILOCARDMED_CARDMED__TEST_DELETE_CAPTURE_AFTER_SUCCESS=false
NILOCARDMED_CARDMED__TEST_DRY_RUN_DEFAULT=false

# --- Resiliencia (Fase 9) ---
NILOCARDMED_RESILIENCE__ENABLED=true
NILOCARDMED_RESILIENCE__WIFI_RECONNECT_ENABLED=true
NILOCARDMED_RESILIENCE__WIFI_RECONNECT_INTERVAL_SECONDS=120
NILOCARDMED_RESILIENCE__WIFI_RECONNECT_ON_CONNECTIVITY_LOSS=true
NILOCARDMED_RESILIENCE__LOG_HEALTH_SUMMARY_INTERVAL_SECONDS=300
NILOCARDMED_RESILIENCE__CHECK_CONNECTIVITY_IN_HEALTH=true
# Activar cuando la URL SER responda a HEAD/GET
NILOCARDMED_RESILIENCE__SER_HEALTH_CHECK_ENABLED=false
NILOCARDMED_RESILIENCE__PAUSE_SAMPLING_WITHOUT_WIFI=true
NILOCARDMED_RESILIENCE__PAUSE_SAMPLING_WITHOUT_CAMERA=true
NILOCARDMED_RESILIENCE__MIN_FREE_DISK_MB=50
NILOCARDMED_RESILIENCE__LOW_MEMORY_MB_THRESHOLD=80
NILOCARDMED_RESILIENCE__WATCHDOG_ENABLED=true
NILOCARDMED_RESILIENCE__WATCHDOG_MAX_STALE_SECONDS=1800
NILOCARDMED_RESILIENCE__PENDING_RETRY_INTERVAL_SECONDS=120
NILOCARDMED_RESILIENCE__DISK_PURGE_CHECK_INTERVAL_SECONDS=60
NILOCARDMED_RESILIENCE__SAMPLER_THREAD_SUPERVISOR_ENABLED=true
NILOCARDMED_RESILIENCE__HEALTH_TREAT_WIFI_PROVISIONING_AS_DEGRADED=true

# --- Almacenamiento local (cola pending, purga por disco) ---
NILOCARDMED_STORAGE__ENABLED=true
NILOCARDMED_STORAGE__MIN_FREE_PERCENT=10
NILOCARDMED_STORAGE__DELETE_AFTER_SUCCESSFUL_UPLOAD=true
NILOCARDMED_STORAGE__RETRY_PENDING_ON_STARTUP=true
NILOCARDMED_STORAGE__PURGE_PENDING_WHEN_LOW=false
NILOCARDMED_STORAGE__PENDING_UPLOAD_MIN_INTERVAL_SECONDS=45
NILOCARDMED_STORAGE__PENDING_UPLOAD_OUTSIDE_WINDOW_ONLY=true

# --- Cámara USB ---
# NILOCARDMED_CAMERA__DEVICE_PATH=/dev/video0
NILOCARDMED_CAMERA__BACKEND=auto
NILOCARDMED_CAMERA__DEVICE_GLOB=/dev/video*
NILOCARDMED_CAMERA__WIDTH=1280
NILOCARDMED_CAMERA__HEIGHT=720
NILOCARDMED_CAMERA__OUTPUT_WIDTH=1280
NILOCARDMED_CAMERA__OUTPUT_HEIGHT=720
NILOCARDMED_CAMERA__RESIZE_AFTER_CAPTURE=true
NILOCARDMED_CAMERA__RESIZE_ONLY_IF_LARGER=true
NILOCARDMED_CAMERA__JPEG_QUALITY=85
NILOCARDMED_CAMERA__CAPTURE_MAX_ATTEMPTS=3
NILOCARDMED_CAMERA__CAPTURE_RETRY_DELAY_SECONDS=2
NILOCARDMED_CAMERA__INPUT_FORMAT=mjpeg
NILOCARDMED_CAMERA__WARMUP_FRAMES=2
NILOCARDMED_CAMERA__WARMUP_SECONDS=1
NILOCARDMED_CAMERA__CAPTURE_TIMEOUT_SECONDS=15
NILOCARDMED_CAMERA__DISCOVERY_TIMEOUT_SECONDS=5
# NILOCARDMED_CAMERA__CAPTURE_DIR=/data/captures
# NILOCARDMED_CAMERA__FSWEBCAM_BINARY=fswebcam
# NILOCARDMED_CAMERA__FFMPEG_BINARY=ffmpeg
# NILOCARDMED_CAMERA__V4L2_CTL_BINARY=v4l2-ctl
