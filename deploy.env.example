# =============================================================================
# NiloCardmed — variables de despliegue (Docker, Compose, systemd)
# Copiar a deploy.env y ajustar antes de instalar en la Raspberry Pi.
# =============================================================================

# --- Instalación en host ---
NILOCARDMED_INSTALL_DIR=/opt/nilocardmed
# Nombre del unit systemd (no usar NILOCARDMED_SERVICE_NAME: pydantic lo confunde con SER)
SYSTEMD_UNIT_NAME=nilocardmed
# install.sh detecta el usuario que ejecuta sudo (p. ej. cardmed; ignora "pi" si no existe)
NILOCARDMED_RUN_USER=pi
NILOCARDMED_RUN_GROUP=pi

# Comando Docker Compose (ruta absoluta; install.sh lo actualiza)
DOCKER_COMPOSE_CMD="/usr/bin/docker compose"
# Ficheros compose a combinar (separados por ':')
COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml
# Directorio de trabajo para compose/systemd
COMPOSE_PROJECT_NAME=nilocardmed
COMPOSE_SERVICE_NAME=nilocardmed

# --- Imagen Docker ---
NILOCARDMED_IMAGE=nilocardmed:latest
NILOCARDMED_CONTAINER_NAME=nilocardmed
BUILD_CONTEXT=.
DOCKERFILE=Dockerfile
# Pi Zero W2 → linux/arm/v7
DOCKER_DEFAULT_PLATFORM=linux/arm/v7

# --- Política de reinicio ---
RESTART_POLICY=unless-stopped

# --- Build args (Dockerfile) ---
PYTHON_IMAGE=python:3.11-slim-bookworm
APP_USER=nilocardmed
APP_UID=1000
APP_GID=1000
APP_HOME=/app
CONTAINER_DATA_DIR=/data
CONTAINER_LOG_DIR=/var/log/nilocardmed

# --- Volúmenes en host (rutas absolutas recomendadas en producción) ---
# Usar rutas absolutas o dejar nombres de volumen nombrados de Docker.
HOST_DATA_DIR=/var/lib/nilocardmed/data
HOST_LOG_DIR=/var/lib/nilocardmed/logs
# Identidad persistente del dispositivo (generada por install.sh):
#   ${HOST_DATA_DIR}/device-identity.env  →  uuid único (SER + BLE NiloCardmed-<uuid>)

# --- Red ---
NETWORK_MODE=bridge

# --- Healthcheck (sobreescribe el del Dockerfile) ---
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_START_PERIOD=20s
HEALTHCHECK_RETRIES=3

# --- Hardware Raspberry Pi (docker-compose.pi.yml) ---
# Hot-plug USB: monta /dev del host; conectar/desconectar cámara sin reiniciar contenedor
ENABLE_CAMERA_HOTPLUG=true
# Solo si ENABLE_CAMERA_HOTPLUG=false: mapeo estático al arrancar
VIDEO_DEVICE_HOST=/dev/video0
VIDEO_DEVICE_CONTAINER=/dev/video0
VIDEO_DEVICE_REQUIRED=false
# Montar bus USB completo (recomendado para enumerar cámaras)
MOUNT_USB_BUS=true
# Grupos del contenedor: nombre del host (p. ej. video); se resuelve a GID en override
CONTAINER_GROUP_ADD=video
# Bluetooth/D-Bus (legacy — desactivado por defecto; código conservado en repo)
BLUETOOTH_ENABLED=false
ENABLE_BLUETOOTH=false
BLUETOOTH_DBUS_SYSTEM_PATH=/var/run/dbus/system_bus_socket

# WiFi (Fase 5): script en host + network host + D-Bus NetworkManager
ENABLE_WIFI=true
WIFI_HOST_SCRIPT_HOST=./scripts/wifi-host.sh
WIFI_HOST_SCRIPT_CONTAINER=/host/scripts/wifi-host.sh
WIFI_DBUS_SYSTEM_PATH=/var/run/dbus/system_bus_socket

# Punto de acceso concurrente (STA wlan0 + AP uap0) para aprovisionamiento local
ENABLE_WIFI_AP=true
WIFI_STA_INTERFACE=wlan0
WIFI_AP_INTERFACE=uap0
WIFI_AP_IP=192.168.4.1
WIFI_AP_CIDR=24
WIFI_AP_SSID_PREFIX=Nilocardmed-Config
WIFI_COUNTRY_CODE=ES

# Modo privilegiado (solo si es estrictamente necesario)
PRIVILEGED_MODE=false

# Límites de recursos (Pi Zero W2)
CONTAINER_MEMORY_LIMIT=384M
CONTAINER_SHM_SIZE=64m
MALLOC_ARENA_MAX=2

# --- Memoria Raspberry Pi Zero 2 W (512 MB RAM) ---
# ENABLE_HOST_SWAP=false → no tocar /etc/fstab ni crear /var/swap (útil si la SD es pequeña)
ENABLE_HOST_SWAP=true
# DISABLE_GUI=true  → sin escritorio; arranque consola (multi-user.target)
DISABLE_GUI=false
# OPTIMIZE_GPU_MEM=true → gpu_mem=16 solo si DISABLE_GUI=true (con escritorio ralentiza el ratón)
OPTIMIZE_GPU_MEM=true
# Opcional: valor gpu_mem si OPTIMIZE_GPU_MEM=true (default 16)
# NILOCARDMED_GPU_MEM_MB=16

# --- Fichero de variables de aplicación montado en compose ---
APP_ENV_FILE=.env

# --- systemd ---
SYSTEMD_WANTED_BY=multi-user.target
SYSTEMD_AFTER="docker.service network-online.target"
SYSTEMD_REQUIRES=docker.service
SYSTEMD_WANTS=network-online.target
